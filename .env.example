# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=placement_cell_db

# Flask Secret Key
SECRET_KEY=placement_cell_super_secret_key_12345

# Production admin login
TPO_USERNAME=tpo_admin
TPO_PASSWORD=replace_with_a_long_random_password

# Keep true locally; use a managed MySQL database in production
ENABLE_SQLITE_FALLBACK=true

# Optional: enable only where Java/LanguageTool is available
ENABLE_LANGUAGE_TOOL=false
